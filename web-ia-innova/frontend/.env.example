# Copia este archivo a ".env.local" (que Git ignora).
# CUIDADO: todo lo que empieza por NEXT_PUBLIC_ es PÚBLICO (viaja al navegador).
# Aquí NUNCA va una clave de API ni la clave secreta/de servicio de Supabase, solo URLs y la clave PÚBLICA.

# URL del backend orquestador. Vacía = el frontend usa respuestas simuladas sin llamar al backend.
NEXT_PUBLIC_ORCHESTRATOR_URL=

# --- Login con Supabase (MVP-1). Guía paso a paso: ../docs/AUTH-SUPABASE.md ---
# URL del proyecto (Project Settings → API → Project URL). Vacía = sin login (modo demo).
NEXT_PUBLIC_SUPABASE_URL=
# Clave PÚBLICA: "publishable key" (sb_publishable_...) o la "anon key" histórica. Está pensada para el navegador.
# NUNCA pegues aquí la "secret key" (sb_secret_...) ni la "service_role": es la llave maestra. Si lo haces,
# la app se niega a usarla, pero la clave ya habría quedado expuesta y habría que rotarla.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
