# Copia este archivo a ".env" (que Git ignora) y rellena los valores.
# El código NO lee este archivo: se carga al arrancar con
#   uvicorn app.main:app --reload --port 8000 --env-file .env
# NUNCA subas el ".env" real. Es como application-secrets.properties en Java.

# Modo de proveedores: "mock" (respuestas simuladas, por defecto) o "real".
PROVIDER_MODE=mock

# Orígenes del frontend permitidos por CORS, separados por comas.
ALLOWED_ORIGINS=http://localhost:3000

# --- Autenticación con Supabase (MVP-1). Guía paso a paso: ../docs/AUTH-SUPABASE.md ---
# "required" (por defecto): /orchestrate y /me exigen un JWT válido de Supabase.
# "disabled": SOLO para desarrollar en local con respuestas simuladas (PROVIDER_MODE=mock). Con
# PROVIDER_MODE=real el backend lo rechaza (503). Cualquier otro valor deja la autenticación activada.
AUTH_MODE=required
# URL del proyecto de Supabase (Project Settings → API → Project URL). Sin ella la autenticación queda
# "sin configurar" y el backend responde 503 en vez de dejar pasar a nadie.
# Para el Supabase local (`supabase start`) sirve http://127.0.0.1:54321 (http solo se acepta hacia localhost).
SUPABASE_URL=
# OPCIONAL, secreto JWT "legado" (HS256). Solo si tu proyecto aún firma con él o quieres seguir aceptando
# tokens firmados con el secreto viejo tras rotar claves. Es un SECRETO: nunca en el frontend ni en Git.
SUPABASE_JWT_SECRET=

# Ruta privada (modelo que atiende lo confidencial). Con PROVIDER_MODE=real y SIN este valor,
# los mensajes privados responden 503 y no se envían a ningún proveedor. Decisión pendiente del grupo.
PRIVATE_ROUTE_URL=

# --- IA Gestora (clasificación real con Gemini Flash-Lite; la generación sigue simulada) ---
# hybrid = reglas + Gemini para lo ambiguo; rules = solo reglas. Sin clave se usa "rules".
GESTORA_MODE=rules
# Clave de Google AI Studio (https://aistudio.google.com/apikey). SOLO aquí, nunca en el frontend.
# PRIVACIDAD: en el nivel gratis Google puede usar los datos para mejorar sus productos.
# Por eso solo se envían los primeros 2000 caracteres y la regla "confidencial" nunca llega a Gemini.
GEMINI_API_KEY=
# Modelo (ID verificado en ai.google.dev). Déjalo vacío para usar el predeterminado.
GEMINI_MODEL=
# Tiempo máximo de espera a Gemini, en segundos (por defecto 4).
GESTORA_TIMEOUT_S=
# Tope local de llamadas a Gemini por minuto (por defecto 15). Protege la cuota gratuita.
GESTORA_MAX_CALLS_PER_MIN=

# Claves de proveedores: solo aquí o en los Secrets del hosting, nunca en el frontend.
# (Se irán añadiendo cuando existan proveedores reales.)
